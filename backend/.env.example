# Copy this file to .env and fill in your own local values.
SECRET_KEY=key
DB_HOST=localhost
DB_PORT=3306
DB_USER=user
DB_PASSWORD=db_pass
DB_NAME=resume_analyzer

# Gemini is optional: leave both empty to use fallback feedback.
GEMINI_API_KEY=api

GEMINI_MODEL=Gemini 3.8 Flash

# Keep false for normal local development; use HTTPS before setting true.
COOKIE_SECURE=false
